# Salin file ini menjadi .env.local lalu isi dengan nilai yang sama seperti secret di GitHub.
# .env.local tidak ikut di-commit (lihat .gitignore).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional: WhatsApp via Fonnte
FONNTE_TOKEN=
WA_TARGET=
# Opsional: siklus (detik) dan jeda unggah ke GitHub (menit)
LIVE_CYCLE_SEC=120
LIVE_PUSH_MIN=5
